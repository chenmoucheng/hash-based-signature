cabal-version: 2.4
name: hash-based-signature
version: 0.1.0.0
synopsis: Minimal experimental hash-based signature library
build-type: Simple
extra-source-files: README.md, test/fixtures/wots.txt, test/fixtures/wots-1-byte.txt, test/generate-fixture.py

common defaults
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat
  build-depends:
      base >=4.18 && <4.19
    , bytestring >=0.11 && <0.12
    , cryptohash-sha256 ==0.11.102.1
    , entropy ==0.4.1.11
    , text >=2.0 && <2.1

library
  import: defaults
  hs-source-dirs: src
  exposed-modules: Crypto.HashBased.Hash, Crypto.HashBased.MessageHash, Crypto.HashBased.WOTS, Crypto.HashBased.WOTSMinus
  other-modules: Crypto.HashBased.WOTS.Internal, Crypto.HashBased.WOTSMinus.Internal, Crypto.HashBased.Internal.DigestText

test-suite tests
  import: defaults
  type: exitcode-stdio-1.0
  hs-source-dirs: test, src
  main-is: Main.hs
  other-modules:
      WOTSMinusTests
      MessageHashTests
      SignatureTextTests
      Crypto.HashBased.Internal.DigestText
      Crypto.HashBased.Hash
      Crypto.HashBased.MessageHash
      Crypto.HashBased.WOTS
      Crypto.HashBased.WOTS.Internal
      Crypto.HashBased.WOTSMinus
      Crypto.HashBased.WOTSMinus.Internal

executable wots-example
  default-language: Haskell2010
  ghc-options: -Wall
  hs-source-dirs: examples
  main-is: Main.hs
  build-depends: base >=4.18 && <4.19, bytestring >=0.11 && <0.12, text >=2.0 && <2.1, hash-based-signature
